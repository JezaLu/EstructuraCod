from collections import deque  #importamos la libreria deque, collection para contener la libreria

class Cola:  #definimos nuestra clase
    def __init__(self):    #def:establecer metodos
        self.items = deque()  #aqui se hace la igualacion con la libreria deque

    def encolar(self,item):  #metodo para agregar elementos a la cola
        self.items.append(item)  #agrega el elemento al final de la cola

    def desencolar(self):  #metodo para eliminar elementos de la cola
        if not self.esta_vacia():  #verifica si la cola no esta vacia
            return self.items.popleft()  #elimina el primer elemento de la cola y lo retorna
        else:
            return None
    def frente(self):  #metodo para ver el primer elemento de la cola sin eliminarlo
        if not self.esta_vacia():
            return self.items[0]  #retorna el primer elemento de la cola
        else:
            return None
        
    def esta_vacia(self):  #metodo para verificar si la cola esta vacia
        return len(self.items) == 0  #retorna verdadero si la cola esta vacia
    
    def tamaño(self):  #metodo para saber el tamaño de la cola
        return len(self.items)  #retorna el numero de elementos en la cola
    
    def mostrar(self):  #metodo para mostrar todos los elementos de la cola
        print("la Cola es:", list(self.items))  #retorna todos los elementos en la cola

