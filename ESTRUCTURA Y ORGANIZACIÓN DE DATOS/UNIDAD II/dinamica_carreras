capacidad=10
pila=[]
def push (elemento):
    if len(pila) < capacidad:
        pila.append(elemento)
        print("elemento agregado: ", elemento)

    else:
        print("la pila esta llena")

def mostrar():
    if pila:
     print("pila (cima-base)",list(reversed(pila)))
    else:
        print("pila vacia")

def menu():
    while True:
        print("Menu de mi pila")
        print("1.Agregar elemento(push) ")
        print("2.Mostrar elementos " )
        print("3.Salir " )

        opcion=input("Selecciona una opcion(1-3) ")
        
        if opcion=="1":
            valor=input("Ingresa el nombre de una carrera profesional(solo ingresa letras): ")
            push(valor)

        elif opcion=="2":
            mostrar()

        elif opcion=="3":
            print("Saliste del programa")
            break

        else:
            print("Ingresaste un dato invalido")

if __name__ == "__main__":
 menu()