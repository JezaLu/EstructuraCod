from collections import deque #se añadió la libreria a importar

class Cola:
    def __init__(self):
        self.items = deque() #hay un .input de más

    def encolar (self,item):
        self.items.append(item)

    def desencolar (self):
        if not self.esta_vacia():
            return self.items.popleft()
        else:
            return None
    
    def frente (self):
        if not self.esta_vacia():
            return self.items[0]
        else:
            return None
        
    def esta_vacia(self):
        return len(self.items)==0 #definir igual a qué es
    
    def mostrar (self):
        print("Cola: ", list(self.items))
    
    def tamaño(self): #definir el metodo para saber el tamaño de la cola
        return len (self.items)

def menu():
    cola = Cola()

    while True:
        print("--MENÚ--")
        print("1.Encolar")
        print("2.Desencolar")
        print("3.Ver frente")
        print("4.Mostrar cola")
        print("5.Verificar si esta vacía")
        print("6.Tamaño de la cola") #tamaño no está definido anteriormente
        print("7.Salir")

        opcion = input("Selecciona una opción:")
        if opcion == "1":
            elemento = input("Ingresa el elemento a encolar: ")
            cola.encolar(elemento)
            #print(f"Elemento ´{elemento}´ encolado.") #el caracter ´´ se confunde con las comillas
            print("Elemento agregado", elemento) #linea de código correcta

        elif opcion == "2":
            elemento = cola.desencolar()
            if elemento is not None:
                #print("Elemento desencolado: {elemento}")
                print("Elemento desencolado: ", elemento)
            else:
                print("La cola está vacía.")

        elif opcion == "3":
            frente = cola.frente()
            if frente is not None:
                #print(f"Frente de la cola: {frente}") 
                print("Frente de la cola: ", frente) #linea correcta
            else: 
                print("La cola está vacía.")

        elif opcion == "4": #se añadió el print
            print("La cola es: ", cola.mostrar())

        elif opcion == "5":
            print("¿Cola está vacía?", "Si" if cola.esta_vacia() else "No")

        elif opcion == "6":
            print("Tamaño de la cola: ", cola.tamaño())
        
        elif opcion == "7":
            print("Saliendo del programa.")
            break #se añadió el break
            
        else:
            print("Opcion inválida. Intenta de nuevo.")

if __name__ == "_main_": #se agregó un _ más a name: __name__
    menu()
    